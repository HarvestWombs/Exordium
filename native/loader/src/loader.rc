// The one immutable pre-1.14 loader. A box keeps Blizzard's original Game.exe for tools that inspect
// its core-specific version resource; this executable runs from Exordium's own native/game folder.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Exordium"
            VALUE "FileDescription", "Exordium game loader"
            VALUE "ProductName", "Exordium"
            VALUE "OriginalFilename", "exordium-game.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
