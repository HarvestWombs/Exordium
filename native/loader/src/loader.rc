// The loader's version resource. Exordium places the loader in a box as Game.exe and stamps
// FILEVERSION / PRODUCTVERSION with the core's own Game.exe version (1.0.10.39 for 1.10f), because
// plugins such as D2GL identify the game by GetFileVersionInfo("game.exe"). 0.0.0.0 means unstamped.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Exordium"
            VALUE "FileDescription", "Exordium game loader"
            VALUE "ProductName", "Exordium"
            VALUE "OriginalFilename", "exordium-game.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
