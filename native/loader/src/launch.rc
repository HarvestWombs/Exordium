// The launcher's version resource. Unlike the loader (loader.rc), exordium-launch.exe is never
// stamped at install time, so its version is fixed here. A small unsigned executable with no version
// information is exactly the shape Defender's ML model scores as a "Settings Modifier" (it quarantined
// this file as Program:Win32/Contebrew.A!ml on 2026-10-04); naming the company, product and file is a
// cheap, honest signal that it is a known program, not anonymous dropped code. Vault:
// Projects/Exordium/Architecture/Launcher.md, "Defender flags the launcher".
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,0,0
PRODUCTVERSION 0,9,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Exordium"
            VALUE "FileDescription", "Exordium launcher: starts a game box and keeps its play record"
            VALUE "ProductName", "Exordium"
            VALUE "ProductVersion", "0.9.0.0"
            VALUE "FileVersion", "0.9.0.0"
            VALUE "OriginalFilename", "exordium-launch.exe"
            VALUE "LegalCopyright", "Exordium"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
