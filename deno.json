{
  "workspace": [
    "./apps/*",
    "./packages/*"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "tasks": {
    "test": "deno test -A packages apps/desktop",
    "check": "deno check packages apps/desktop/server.ts apps/desktop/src/main.tsx",
    "build:loader": "powershell -NoProfile -ExecutionPolicy Bypass -File native/loader/build.ps1 && deno run -A apps/desktop/stamp-game.ts",
    "build:window": "powershell -NoProfile -ExecutionPolicy Bypass -File native/window/build.ps1",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test",
    "cores:catalog": "deno run --allow-read=Cores --allow-write=Cores apps/desktop/cores.ts Cores"
  },
  "fmt": {
    "lineWidth": 120,
    // Prose is not reflowed: the design lives in an Obsidian vault that soft-wraps.
    "exclude": ["README.md", "CLAUDE.md", "apps/desktop/dist"]
  },
  "lint": {
    "exclude": ["apps/desktop/dist"]
  }
}
