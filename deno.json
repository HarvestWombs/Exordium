{
  "workspace": [
    "./packages/*"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "tasks": {
    "test": "deno test -A packages",
    "check": "deno check packages",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 120,
    // Prose is not reflowed: the design lives in an Obsidian vault that soft-wraps.
    "exclude": ["README.md", "CLAUDE.md"]
  }
}
